# Copy this file to .env and fill in the values you have. Never commit .env.
#
# Everything below has a safe default in app/core/config.py, so you can start
# with an empty .env and the app will run using yfinance (no key needed) with
# news disabled ("News unavailable — technical analysis only") and in-app
# notifications only. Add keys as you get them.

# ============================= App / environment ============================
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false

# ================================= Database ==================================
# SQLite (zero-config local dev):
DATABASE_URL=sqlite:///./data/app.db
# PostgreSQL (used automatically by docker-compose - do not set this yourself
# when using `docker compose up`, it is injected for you):
# DATABASE_URL=postgresql+psycopg2://stocksignal:stocksignal@postgres:5432/stocksignal
POSTGRES_USER=stocksignal
POSTGRES_PASSWORD=stocksignal
POSTGRES_DB=stocksignal

# ============================= Market data provider ==========================
# one of: yfinance | alpha_vantage | finnhub | polygon | twelvedata
MARKET_DATA_PROVIDER=yfinance
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
TWELVEDATA_API_KEY=

# ================================ News provider ===============================
# one of: newsapi | none
NEWS_PROVIDER=newsapi
NEWSAPI_API_KEY=
NEWS_CACHE_TTL_MINUTES=30

# ================================ Notifications ================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================= Scheduler / polling =============================
POLLING_ENABLED=true
POLL_INTERVAL_SECONDS_INTRADAY=60
POLL_INTERVAL_SECONDS_DAILY=900

# ============================= Signal engine defaults ===========================
DEFAULT_MIN_SIGNAL_SCORE=70
DEFAULT_TIMEFRAMES=15m,1h,1d
DEFAULT_ALERT_COOLDOWN_MINUTES=240
ALLOW_FORMING_PATTERN_DETECTION=true

# ==================================== API =======================================
API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SECRET_KEY=change-me-in-production

# ================================== Frontend ====================================
VITE_API_BASE_URL=http://localhost:8000
